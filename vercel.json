{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/seo/auto-boost",
      "schedule": "0 3 * * *"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -qF '[skip ci]'"
}
